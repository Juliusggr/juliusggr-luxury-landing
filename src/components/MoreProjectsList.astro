---
interface Repo {
  name: string;
  href: string;
}

interface Props {
  repos: Repo[];
}

const { repos } = Astro.props;
const mid = Math.ceil(repos.length / 2);
const columns = [repos.slice(0, mid), repos.slice(mid)];
---

{
  repos.length > 0 && (
    <section class="px-5 pb-28 pt-16 md:px-8" aria-labelledby="more-projects">
      <h2 id="more-projects" class="max-w-[12ch] font-serif text-[clamp(2.6rem,5vw,4.4rem)] leading-[1.05] tracking-tight">
        <span data-lang="es">Más Proyectos &amp; Contribuciones</span>
        <span data-lang="en">More projects &amp; contributions</span>
      </h2>
      <div class="mt-14 grid gap-x-16 md:grid-cols-2">
        {columns.map((column) => (
          <ul>
            {column.map((repo) => (
              <li class="border-b border-[var(--line-strong)]">
                <a href={repo.href} target="_blank" rel="noreferrer" class="circle-link group flex items-center justify-between gap-6 py-5">
                  <span class="font-serif text-[1.7rem] leading-none tracking-tight">{repo.name}</span>
                  <span class="circle-btn shrink-0" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="size-3.5">
                      <path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>
  )
}
